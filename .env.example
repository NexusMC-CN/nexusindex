# NexusIndex HTTP 服务端口。
NEXUSINDEX_PORT=4412

# /api/*、/search、/index/* 路由的可选鉴权 token。
# 本地开发可留空；生产建议设置随机长字符串。
NEXUSINDEX_API_TOKEN=

# HTTP handler 单次请求超时时间，单位毫秒。
# rebuild 接口只负责投递异步任务，因此该值主要保护搜索、标签、状态、
# runtime config 和索引写入请求。
NEXUSINDEX_REQUEST_TIMEOUT_MS=5000

# 论坛主库同步连接。变量名为兼容历史配置而保留 READONLY。
# 该连接用于：
# - SELECT 论坛内容表，构建 search_index
# - 读取/标记 search_index_events，完成异步索引同步
# 生产建议使用最小权限账号：内容表 SELECT，search_index_events SELECT，
# 并仅 UPDATE locked_at/attempts/processed_at/failed_at/last_error/updated_at。
MAIN_DATABASE_READONLY_URL=postgresql://readonly_user:readonly_password@127.0.0.1:5432/nexusmc

# 独立 PostgreSQL 索引库连接。
# 该库是可删除、可重建的辅助库；NexusIndex 会在这里创建和写入
# search_index、tag_index、index_sync_log。
INDEX_DATABASE_URL=postgresql://index_user:index_password@127.0.0.1:5432/nexusmc_index

# EdgeCache 集成。
# 业务代码禁止直接访问 Redis。NexusIndex 只通过 EdgeCacheAdapter 访问
# EdgeCache；Redis 只能作为 EdgeCache 背后的 L2 backend 存在。
NEXUSINDEX_EDGECACHE_ENABLED=false
NEXUSINDEX_EDGECACHE_URL=http://127.0.0.1:4410
NEXUSINDEX_EDGECACHE_TIMEOUT_MS=300

# 默认缓存 TTL，单位秒。用于 tags 缓存和兜底 TTL。
NEXUSINDEX_EDGECACHE_TTL_SECONDS=60

# V2 缓存分层：
# - L1：nexusindex 进程内 memory cache
# - L2：EdgeCache backend
NEXUSINDEX_CACHE_NAMESPACE=nexusindex:v2
NEXUSINDEX_CACHE_L1_MAX_ENTRIES=2048
NEXUSINDEX_CACHE_QUERY_TTL_SECONDS=60
NEXUSINDEX_CACHE_FILTER_TTL_SECONDS=120
NEXUSINDEX_CACHE_HIGHLIGHT_TTL_SECONDS=300

# Index Sync worker。
# forum 写入路径只写 search_index_events，不直接调用 NexusIndex update。
# worker 异步消费事件、更新 search_index/tag_index，并触发搜索缓存 version bump。
NEXUSINDEX_WORKER_ENABLED=true
NEXUSINDEX_WORKER_BATCH_SIZE=200
NEXUSINDEX_WORKER_POLL_INTERVAL_MS=2000
NEXUSINDEX_WORKER_LOCK_TTL_MS=120000
NEXUSINDEX_WORKER_RETRY_DELAY_MS=30000
NEXUSINDEX_WORKER_MAX_ATTEMPTS=10

# 可选 runtime config JSON 文件路径。
# 可通过 POST /api/config/reload 热加载。
# 留空时使用默认配置 + 环境变量 override。
NEXUSINDEX_RUNTIME_CONFIG_FILE=

# PostgreSQL 候选集窗口大小，用于 Go 层 scoring/rerank。
# 有效范围：100 - 5000。默认：1000。
NEXUSINDEX_CANDIDATE_LIMIT=1000

# Scoring 权重配置。
# 未设置的变量会使用 runtime 默认值；显式设置为 0 会被视为有效 override。
# 默认值：
# title=8，tags=5，keywords=3，payload=1，
# view=0.30，download=0.50，like=0.70，time_decay=30 天。
#
# NEXUSINDEX_SCORING_TITLE_WEIGHT=8
# NEXUSINDEX_SCORING_TAGS_WEIGHT=5
# NEXUSINDEX_SCORING_KEYWORDS_WEIGHT=3
# NEXUSINDEX_SCORING_PAYLOAD_WEIGHT=1
# NEXUSINDEX_SCORING_VIEW_COUNT_WEIGHT=0.30
# NEXUSINDEX_SCORING_DOWNLOAD_COUNT_WEIGHT=0.50
# NEXUSINDEX_SCORING_LIKE_COUNT_WEIGHT=0.70
# NEXUSINDEX_SCORING_TIME_DECAY_FACTOR=30
